{
    "name": "swage/nightwatch",
    "description": "Laravel Nightwatch monitoring for sites deployed with Swage.",
    "type": "swage-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "livewire/livewire": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Swage\\Nightwatch\\": "src/"
        }
    },
    "extra": {
        "swage": {
            "kind": "site-integration",
            "contract": 1
        },
        "laravel": {
            "providers": [
                "Swage\\Nightwatch\\NightwatchServiceProvider"
            ]
        }
    }
}
